<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Comentários XML das actions alimentam o documento OpenAPI -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarrinhoCompras.Application\CarrinhoCompras.Application.csproj" />
    <!-- Referência usada apenas para compor a injeção de dependência (composition root) -->
    <ProjectReference Include="..\CarrinhoCompras.Infrastructure\CarrinhoCompras.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
    <!-- Necessário para as ferramentas do EF (migrations/bundle) usarem a API como projeto de inicialização -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
