# Opcional: copie para .env para mudar portas ou credenciais do docker-compose.
# Os valores abaixo são os padrões usados quando o .env não existe.
POSTGRES_DB=carrinho_compras
POSTGRES_USER=carrinho
POSTGRES_PASSWORD=carrinho
POSTGRES_PORT=5432
API_PORT=5080
WEB_PORT=3000

# Por quanto tempo a sacola segura as mercadorias antes de devolvê-las à vitrine (hh:mm:ss).
# O padrão de negócio é 00:15:00; o compose usa 2 minutos para a demonstração ficar visível.
RESERVA_JANELA=00:02:00
